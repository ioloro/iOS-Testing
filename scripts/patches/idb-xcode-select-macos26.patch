   @objc public class func symlinkedDeveloperDirectory() throws -> String {
-    let directory = ("/var/db/xcode_select_link" as NSString).resolvingSymlinksInPath
-    try validateXcodeDirectory(directory)
-    return directory
+    let symlinkPath = "/var/db/xcode_select_link"
+    if FileManager.default.fileExists(atPath: symlinkPath) {
+      let directory = (symlinkPath as NSString).resolvingSymlinksInPath
+      try validateXcodeDirectory(directory)
+      return directory
+    }
+    // macOS 26+ stores xcode-select state differently; the symlink doesn't
+    // exist. Fall back to invoking `xcode-select -p` synchronously.
+    let task = Process()
+    task.executableURL = URL(fileURLWithPath: "/usr/bin/xcode-select")
+    task.arguments = ["--print-path"]
+    let pipe = Pipe()
+    task.standardOutput = pipe
+    try task.run()
+    task.waitUntilExit()
+    let data = pipe.fileHandleForReading.readDataToEndOfFile()
+    let directory = String(data: data, encoding: .utf8)?.trimmingCharacters(in: .whitespacesAndNewlines)
+    try validateXcodeDirectory(directory)
+    return directory!
   }

